{
  "name": "ineka-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "docs:generate": "typedoc",
    "docs:dev": "pnpm --filter @ineka/docs run dev",
    "docs:build": "pnpm --filter @ineka/docs run build",
    "example:dev": "pnpm --filter @ineka/example run dev",
    "example:build": "pnpm --filter @ineka/example run build",
    "release:publish": "changeset publish",
    "release:version": "changeset version"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "eslint": "^10.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {},
  "optionalDependencies": {},
  "peerDependencies": {},
  "packageManager": "pnpm@11.2.2"
}
